    {
      "op": "spawn",
      "deck": "main",
      "to": "pioche"
    },
    {
      "op": "shuffle",
      "zone": "pioche"
    }
  ],
  "macros": [
    {
      "id": "donner",
      "name": "Distribuer…",
      "group": "Mise en place",
      "params": [
        {
          "id": "n",
          "name": "Cartes par joueur",
          "min": 1,
          "max": 26,
          "default": 5
        }
      ],
      "steps": [
        {
          "op": "deal",
          "from": "pioche",
          "to": "main",
          "count": "$n"
        }
      ]
    },
    {
      "id": "ramasser",
      "name": "Tout ramasser et mélanger",
      "steps": [
        {
          "op": "gather",
          "to": "pioche"
        },
        {
          "op": "shuffle",
          "zone": "pioche"
        }
      ],
      "group": "Mise en place"
    },
    {
      "id": "donneTout",
      "name": "Distribuer tout le paquet",
      "steps": [
        {
          "op": "deal",
          "from": "pioche",
          "to": "main",
          "count": "all"
        }
      ],
      "group": "Mise en place"
    },
    {
      "id": "piocher",
      "name": "Piocher…",
      "group": "À mon tour",
      "scope": "me",
      "params": [
        {
          "id": "n",
          "name": "Cartes à piocher",
          "min": 1,
          "max": 10,
          "default": 1
        }
      ],
      "steps": [
        {
          "op": "move",
          "from": "pioche",
          "to": "main",
          "count": "$n"
        }
      ]
    }
  ],
  "quickstart": [
    "Lancez une action de table pour distribuer (à droite).",
    "Double-clic sur la pioche : piocher. Double-clic sur une carte de votre main : la jouer.",
    "Glissez les cartes où vous voulez ; le menu ⋯ d'une zone mélange, étale ou distribue.",
    "Aucune règle n'est imposée : jouez à ce que vous voulez."
