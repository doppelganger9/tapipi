{
  "format": "tapis/1",
  "id": "classique-32",
  "name": "Jeu de 32 cartes",
  "description": "Le paquet de 32 cartes (du 7 à l'as) des jeux de levées traditionnels : belote, manille, écarté…",
  "author": "Tapipi",
  "license": "CC0-1.0",
  "players": {
    "min": 2,
    "max": 4
  },
  "rules": "Table libre avec un jeu de 32 cartes.\n\nJouez une carte en la glissant sur le tapis (ou double-clic depuis votre main). Le gagnant du pli sélectionne les cartes du tapis et les glisse sur sa pile « Plis ».\n\nUtilisez le compteur de score et « Fin du tour » pour suivre la partie.",
  "decks": {
    "main": {
      "preset": "standard32",
      "back": {
        "color": "#1f4e79",
        "label": "❖"
      },
      "name": "Jeu de 32 cartes"
    }
  },
  "zones": [
    {
      "id": "talon",
      "name": "Talon",
      "visibility": "hidden",
      "layout": "stack"
    },
    {
      "id": "tapis",
      "name": "Tapis",
      "visibility": "public",
      "layout": "free"
    },
    {
      "id": "main",
      "name": "Main",
      "owner": "player",
      "visibility": "owner",
      "layout": "row"
    },
    {
      "id": "plis",
      "name": "Plis",
      "owner": "player",
      "visibility": "hidden",
      "layout": "stack"
    }
  ],
  "counters": [
    {
      "id": "score",
      "name": "Score",
      "scope": "player",
      "initial": 0
    }
  ],
  "ui": {
    "hand": "main",
    "draw": "talon",
    "play": "tapis"
  },
  "setup": [
    {
      "op": "spawn",
      "deck": "main",
      "to": "talon"
    },
    {
      "op": "shuffle",
      "zone": "talon"
    }
  ],
  "macros": [
    {
      "id": "donner",
      "name": "Distribuer…",
      "group": "Mise en place",
      "params": [
        {
          "id": "n",
          "name": "Cartes par joueur",
          "min": 1,
          "max": 26,
          "default": 5
        }
      ],
      "steps": [
        {
          "op": "deal",
          "from": "talon",
          "to": "main",
          "count": "$n"
        }
      ]
    },
    {
      "id": "donne32",
      "name": "Donne 3 puis 2",
      "group": "Mise en place",
      "steps": [
        {
          "op": "deal",
          "from": "talon",
          "to": "main",
          "count": 3,
          "by": 3
        },
        {
          "op": "deal",
          "from": "talon",
          "to": "main",
          "count": 2,
          "by": 2
        }
      ]
    },
    {
      "id": "ramasser",
      "name": "Tout ramasser et mélanger",
      "steps": [
        {
          "op": "gather",
          "to": "talon"
        },
        {
          "op": "shuffle",
          "zone": "talon"
        }
      ],
      "group": "Mise en place"
    },
    {
      "id": "donneTout",
      "name": "Distribuer tout le paquet",
      "steps": [
        {
          "op": "deal",
          "from": "talon",
          "to": "main",
          "count": "all"
        }
      ],
      "group": "Mise en place"
    },
    {
      "id": "retourne",
      "name": "Retourner une carte du talon",
      "steps": [
        {
          "op": "move",
          "from": "talon",
          "to": "tapis",
          "count": 1
        }
      ],
      "group": "Mise en place"
    },
    {
      "id": "piocher",
      "name": "Piocher…",
      "group": "À mon tour",
      "scope": "me",
      "params": [
        {
          "id": "n",
          "name": "Cartes à piocher",
          "min": 1,
          "max": 10,
          "default": 1
        }
      ],
      "steps": [
        {
          "op": "move",
          "from": "talon",
          "to": "main",
          "count": "$n"
        }
      ]
    }
  ],
  "quickstart": [
    "Distribuez avec une action de table (à droite).",
    "Double-clic sur une carte de votre main pour la jouer sur le tapis.",
    "Le gagnant du pli sélectionne les cartes et les glisse sur sa pile « Plis »."
  ]
}
